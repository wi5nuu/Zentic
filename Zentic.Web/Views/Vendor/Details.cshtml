@model Zentic.Application.DTOs.VendorDto
@{
    ViewData["Title"] = "Vendor Details";
}
<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i>Back to Vendors</a>
    <h4 class="fw-bold mt-1 mb-0"><i class="bi bi-shop me-2 text-primary"></i>Vendor Details</h4>
</div>

<div class="row g-3">
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm">
            <div class="card-header">
                <span class="fw-semibold">Vendor Information</span>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted small fw-semibold" style="width:40%">Vendor Name</td>
                        <td class="fw-semibold">@Model.Name</td>
                    </tr>
                    <tr>
                        <td class="text-muted small fw-semibold">Vendor Code</td>
                        <td><span class="badge bg-light text-dark border">@Model.Code</span></td>
                    </tr>
                    <tr>
                        <td class="text-muted small fw-semibold">Status</td>
                        <td>
                            @if (Model.Status == "Active")
                            {
                                <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary-subtle text-secondary border">@Model.Status</span>
                            }
                        </td>
                    </tr>
                    <tr>
                        <td class="text-muted small fw-semibold">Address</td>
                        <td>@(string.IsNullOrEmpty(Model.Address) ? "-" : Model.Address)</td>
                    </tr>
                    <tr>
                        <td class="text-muted small fw-semibold">Phone</td>
                        <td>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "-" : Model.PhoneNumber)</td>
                    </tr>
                    <tr>
                        <td class="text-muted small fw-semibold">Email</td>
                        <td>@(string.IsNullOrEmpty(Model.Email) ? "-" : Model.Email)</td>
                    </tr>
                    <tr>
                        <td class="text-muted small fw-semibold">Tax ID (NPWP)</td>
                        <td>@(string.IsNullOrEmpty(Model.TaxId) ? "-" : Model.TaxId)</td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header">
                <span class="fw-semibold">Bank Account <span class="badge bg-info-subtle text-info border ms-1" style="font-size:0.65rem;">AES-256 Encrypted at Rest</span></span>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted small fw-semibold" style="width:40%">Bank Name</td>
                        <td>@(string.IsNullOrEmpty(Model.BankName) ? "-" : Model.BankName)</td>
                    </tr>
                    <tr>
                        <td class="text-muted small fw-semibold">Account Holder</td>
                        <td>@(string.IsNullOrEmpty(Model.BankAccountHolderName) ? "-" : Model.BankAccountHolderName)</td>
                    </tr>
                    <tr>
                        <td class="text-muted small fw-semibold">Account Number</td>
                        <td>@(Model.MaskedAccountNumber ?? "-")</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header">
                <span class="fw-semibold">Verification</span>
            </div>
            <div class="card-body">
                <table class="table table-borderless mb-0">
                    <tr>
                        <td class="text-muted small fw-semibold" style="width:40%">Verified By</td>
                        <td>@(string.IsNullOrEmpty(Model.VerifiedByName) ? "-" : Model.VerifiedByName)</td>
                    </tr>
                    <tr>
                        <td class="text-muted small fw-semibold">Verified At</td>
                        <td>@(Model.VerifiedAt?.ToString("dd MMM yyyy HH:mm") ?? "-")</td>
                    </tr>
                </table>
            </div>
        </div>

        <div class="d-flex gap-2 mt-3">
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary"><i class="bi bi-pencil me-1"></i>Edit</a>
            @if (Model.Status == "PendingVerification")
            {
                <form asp-action="Verify" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success"><i class="bi bi-patch-check me-1"></i>Verify & Activate</button>
                </form>
            }
            @if (Model.Status == "Active" || Model.Status == "Suspended")
            {
                <form asp-action="Suspend" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn @(Model.Status == "Active" ? "btn-warning" : "btn-success")">
                        <i class="bi @(Model.Status == "Active" ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                        @(Model.Status == "Active" ? "Suspend" : "Re-activate")
                    </button>
                </form>
            }
        </div>
    </div>
</div>
