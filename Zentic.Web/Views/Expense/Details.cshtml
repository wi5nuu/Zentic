@model Zentic.Application.DTOs.ExpenseRequisitionDto
@{
    ViewData["Title"] = Model.RequisitionNumber;
    var isFinanceOrAdmin = User.IsInRole("Finance") || User.IsInRole("Admin");
    var currentUserId = User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
    var isOwner = currentUserId == Model.RequesterId.ToString();
    var canApprove = isFinanceOrAdmin && (Model.Status == "Submitted" || Model.Status == "UnderReview");
}
<div class="mb-4">
    <a asp-action="Index" class="text-decoration-none text-muted small"><i class="bi bi-arrow-left me-1"></i>Back to list</a>
    <div class="d-flex justify-content-between align-items-start mt-1">
        <div>
            <h4 class="fw-bold mb-1">@Model.Title</h4>
            <span class="text-muted small">@Model.RequisitionNumber</span>
            @if (Model.IsFlaggedForReview)
            {
                <span class="badge bg-danger ms-2"><i class="bi bi-flag-fill me-1"></i>Flagged for Review</span>
            }
        </div>
        <span class="@Model.StatusBadgeClass">@Model.Status</span>
    </div>
</div>

@if (Model.IsFlaggedForReview)
{
    <div class="alert alert-warning mb-4">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong>Anti-fraud Alert:</strong> @Model.FlagReason
        @if (Model.PriceDeviation.HasValue)
        {
            <span>(Deviation: @Model.PriceDeviation.Value.ToString("F1")%)</span>
        }
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-0 pt-3 pb-0"><h6 class="fw-bold">Requisition Details</h6></div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4 text-muted fw-normal">Title</dt>
                    <dd class="col-sm-8">@Model.Title</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Category</dt>
                    <dd class="col-sm-8">@Model.Category</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Department</dt>
                    <dd class="col-sm-8">@Model.DepartmentName</dd>
                    @if (!string.IsNullOrEmpty(Model.VendorName))
                    {
                        <dt class="col-sm-4 text-muted fw-normal">Vendor</dt>
                        <dd class="col-sm-8">@Model.VendorName</dd>
                    }
                    <dt class="col-sm-4 text-muted fw-normal">Amount</dt>
                    <dd class="col-sm-8 fw-bold fs-5">Rp @Model.Amount.ToString("N0")</dd>
                    <dt class="col-sm-4 text-muted fw-normal">Created</dt>
                    <dd class="col-sm-8">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</dd>
                    @if (Model.SubmittedAt.HasValue)
                    {
                        <dt class="col-sm-4 text-muted fw-normal">Submitted</dt>
                        <dd class="col-sm-8">@Model.SubmittedAt.Value.ToString("dd MMM yyyy HH:mm")</dd>
                    }
                    @if (Model.ApprovedAt.HasValue && Model.Status != "Rejected")
                    {
                        <dt class="col-sm-4 text-muted fw-normal">Approved</dt>
                        <dd class="col-sm-8">@Model.ApprovedAt.Value.ToString("dd MMM yyyy HH:mm")</dd>
                    }
                    @if (Model.PaidAt.HasValue)
                    {
                        <dt class="col-sm-4 text-muted fw-normal">Paid</dt>
                        <dd class="col-sm-8">@Model.PaidAt.Value.ToString("dd MMM yyyy HH:mm")</dd>
                    }
                    @if (Model.RejectedAt.HasValue)
                    {
                        <dt class="col-sm-4 text-muted fw-normal">Rejected</dt>
                        <dd class="col-sm-8">@Model.RejectedAt.Value.ToString("dd MMM yyyy HH:mm")</dd>
                    }
                </dl>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(Model.ApprovalNotes) || !string.IsNullOrEmpty(Model.RejectionReason))
        {
            <div class="card border-0 shadow-sm mb-3 @(Model.Status == "Rejected" ? "border-danger" : "border-success") border-start border-3">
                <div class="card-body">
                    <h6 class="fw-bold mb-1">@(Model.Status == "Rejected" ? "Rejection Reason" : "Approval Notes")</h6>
                    <p class="mb-0 text-muted">@(Model.ApprovalNotes ?? Model.RejectionReason)</p>
                    @if (!string.IsNullOrEmpty(Model.ApproverName))
                    {
                        <small class="text-muted">— @Model.ApproverName</small>
                    }
                </div>
            </div>
        }

        @if (Model.ApprovalHistory.Any())
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white border-0 pt-3 pb-0"><h6 class="fw-bold">Approval Timeline</h6></div>
                <div class="card-body">
                    @foreach (var h in Model.ApprovalHistory)
                    {
                        <div class="d-flex gap-3 mb-3">
                            <div class="text-center" style="min-width:60px;">
                                <div class="text-muted small">@h.Timestamp.ToString("HH:mm")</div>
                                <div class="text-muted small">@h.Timestamp.ToString("dd MMM")</div>
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold">@h.ActorName <span class="badge bg-secondary">@h.Action</span></div>
                                <div class="small text-muted">@h.FromStatus → @h.ToStatus</div>
                                @if (!string.IsNullOrEmpty(h.Notes))
                                {
                                    <div class="small mt-1">@h.Notes</div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        @if (canApprove)
        {
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 pt-3 pb-0"><h6 class="fw-bold">Review Requisition</h6></div>
                <div class="card-body">
                    <form asp-action="Approve" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Notes (optional)</label>
                            <textarea name="notes" class="form-control" rows="3" placeholder="Add approval notes..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-success"><i class="bi bi-check-circle me-2"></i>Approve</button>
                    </form>
                    <form asp-action="Reject" method="post" class="mt-2">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Rejection Reason (required)</label>
                            <textarea name="reason" class="form-control" rows="2" placeholder="State reason for rejection..." required></textarea>
                        </div>
                        <button type="submit" class="btn btn-danger"><i class="bi bi-x-circle me-2"></i>Reject</button>
                    </form>
                </div>
            </div>
        }
    </div>

    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-3">
            <div class="card-header bg-white border-0 pt-3 pb-0"><h6 class="fw-bold">Requester</h6></div>
            <div class="card-body">
                <div class="d-flex align-items-center gap-2 mb-2">
                    <div class="rounded-circle bg-primary d-flex align-items-center justify-content-center" style="width:40px;height:40px;">
                        <i class="bi bi-person-fill text-white"></i>
                    </div>
                    <div>
                        <div class="fw-semibold">@Model.RequesterName</div>
                        <div class="text-muted small">@Model.DepartmentName</div>
                    </div>
                </div>
                <div class="small text-muted">@Model.RequesterEmail</div>
            </div>
        </div>

        @if (Model.Status == "Draft")
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body d-flex flex-column gap-2">
                    <form asp-action="Submit" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100"><i class="bi bi-send me-2"></i>Submit for Approval</button>
                    </form>
                    <form asp-action="Cancel" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Cancel this requisition?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-danger w-100"><i class="bi bi-x-circle me-2"></i>Cancel</button>
                    </form>
                </div>
            </div>
        }

        @if (Model.Status == "Approved" && isFinanceOrAdmin)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body">
                    <form asp-action="MarkAsPaid" asp-route-id="@Model.Id" method="post" onsubmit="return confirm('Confirm payment has been made for this requisition?')">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success w-100"><i class="bi bi-cash-coin me-2"></i>Mark as Paid</button>
                    </form>
                </div>
            </div>
        }
    </div>
</div>

@if (isFinanceOrAdmin)
{
    var canManageQuotations = Model.Status == "Draft" || Model.Status == "Submitted" || Model.Status == "UnderReview";
    <div class="card border-0 shadow-sm mt-3">
        <div class="card-header bg-white border-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
            <h6 class="fw-bold mb-0"><i class="bi bi-file-earmark-text me-2"></i>Vendor Quotations</h6>
            <span class="text-muted small">3-way matching: quotations vs requested amount</span>
        </div>
        <div class="card-body">
            @if (!Model.Quotations.Any())
            {
                <p class="text-muted small mb-3">No quotations recorded yet.</p>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Vendor</th>
                                <th>Quoted Price</th>
                                <th>Date</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model.Quotations)
                            {
                                <tr>
                                    <td class="fw-semibold small">@q.VendorName</td>
                                    <td class="small">Rp @q.QuotedPrice.ToString("N0")</td>
                                    <td class="small text-muted">@q.QuotationDate.ToString("dd MMM yyyy")</td>
                                    <td>
                                        @if (q.IsSelected)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Selected</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-dark border">Submitted</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (canManageQuotations)
                                        {
                                            <form asp-action="SelectQuotation" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requisitionId" value="@Model.Id" />
                                                <input type="hidden" name="quotationId" value="@q.Id" />
                                                <input type="hidden" name="reason" value="" />
                                                <button type="submit" class="btn btn-sm btn-outline-success" @(q.IsSelected ? "disabled" : "") title="Select this quotation">
                                                    <i class="bi bi-check2"></i>
                                                </button>
                                            </form>
                                            <form asp-action="RemoveQuotation" method="post" class="d-inline" onsubmit="return confirm('Remove this quotation?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="requisitionId" value="@Model.Id" />
                                                <input type="hidden" name="quotationId" value="@q.Id" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove quotation">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                                @if (q.IsSelected && !string.IsNullOrEmpty(q.SelectionReason))
                                {
                                    <tr>
                                        <td colspan="5" class="small text-muted ps-4"><i class="bi bi-chat-left-text me-1"></i>@q.SelectionReason</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }

            @if (canManageQuotations)
            {
                <form asp-action="AddQuotation" method="post" class="row g-2 align-items-end mt-3 pt-3 border-top">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="RequisitionId" value="@Model.Id" />
                    <div class="col-12 col-md-4">
                        <label class="form-label fw-semibold small mb-1">Vendor</label>
                        <select name="VendorId" class="form-select form-select-sm" required>
                            <option value="">Select vendor...</option>
                            @foreach (var v in ViewBag.Vendors)
                            {
                                <option value="@v.Value" selected="@(v.Value == Model.VendorId?.ToString())">@v.Text</option>
                            }
                        </select>
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label fw-semibold small mb-1">Quoted Price (Rp)</label>
                        <input type="number" name="QuotedPrice" class="form-control form-control-sm" step="0.01" min="1" required />
                    </div>
                    <div class="col-6 col-md-3">
                        <label class="form-label fw-semibold small mb-1">Quotation Date</label>
                        <input type="date" name="QuotationDate" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" required />
                    </div>
                    <div class="col-12 col-md-2 d-flex gap-2">
                        <button type="submit" class="btn btn-sm btn-primary flex-fill"><i class="bi bi-plus-lg me-1"></i>Add</button>
                    </div>
                </form>
                <small class="text-muted mt-2 d-block">
                    @if (Model.Amount >= 50000000)
                    {
                        <i class="bi bi-info-circle me-1"></i><span>This requisition is above the quotation threshold and requires at least 2 quotations before it can be approved.</span>
                    }
                    else
                    {
                        <i class="bi bi-info-circle me-1"></i><span>Quotations are optional for requisitions below the threshold (Rp 50,000,000).</span>
                    }
                </small>
            }
        </div>
    </div>
}
