@model Zentic.Application.DTOs.PaginatedResult<Zentic.Application.DTOs.ExpenseRequisitionDto>
@{
    ViewData["Title"] = "Expense Requisitions";
    var filter = ViewBag.Filter as Zentic.Application.DTOs.ExpenseFilterDto;
}
<div class="d-flex justify-content-between align-items-center mb-4 page-header-row">
    <div>
        <h4 class="fw-bold mb-0">Expense Requisitions</h4>
        <p class="text-muted small mb-0">@Model.TotalCount total records</p>
    </div>
    <div class="d-flex gap-2">
        @if (User.IsInRole("Admin") || User.IsInRole("Finance"))
        {
            <a asp-action="Export" asp-route-status="@filter?.Status" asp-route-search="@filter?.Search" asp-route-category="@filter?.Category" asp-route-flagged="@filter?.Flagged"
               class="btn btn-outline-secondary" title="Export filtered list to CSV"><i class="bi bi-download me-2"></i>Export CSV</a>
        }
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-circle me-2"></i>New Requisition</a>
    </div>
</div>
<div class="card border-0 shadow-sm mb-3">
    <div class="card-body py-2">
        <form method="get" class="row g-2 align-items-center filter-form">
            <div class="col-12 col-md-4">
                <div class="input-group input-group-sm">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@filter?.Search" class="form-control" placeholder="Search by title or number..." />
                </div>
            </div>
            <div class="col-6 col-md-3">
                <select name="status" class="form-select form-select-sm">
                    <option value="">All Statuses</option>
                    @foreach (var s in Enum.GetNames<RequisitionStatus>())
                    {
                        <option value="@s" selected="@(filter?.Status == s)">@s</option>
                    }
                </select>
            </div>
            <div class="col-6 col-md-3">
                <select name="category" class="form-select form-select-sm">
                    <option value="">All Categories</option>
                    @foreach (var c in Enum.GetNames<ExpenseCategory>())
                    {
                        <option value="@c" selected="@(filter?.Category == c)">@c</option>
                    }
                </select>
            </div>
            <div class="col-12 col-md-auto d-flex gap-2">
                <button type="submit" class="btn btn-sm btn-primary flex-fill">Filter</button>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary flex-fill">Clear</a>
            </div>
        </form>
    </div>
</div>
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Number</th>
                        <th>Title</th>
                        <th class="table-mobile-hide">Amount</th>
                        <th class="table-mobile-hide">Requester</th>
                        <th>Status</th>
                        <th class="table-mobile-hide">Date</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Items.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No requisitions found.</td></tr>
                    }
                    @foreach (var r in Model.Items)
                    {
                        <tr>
                            <td class="ps-3 small text-muted">@r.RequisitionNumber</td>
                            <td>
                                <div class="fw-semibold" style="max-width:180px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">@r.Title</div>
                                @if (r.IsFlaggedForReview)
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.65rem;"><i class="bi bi-flag-fill me-1"></i>Flagged</span>
                                }
                                <div class="text-muted small d-md-none">Rp @r.Amount.ToString("N0")</div>
                            </td>
                            <td class="small text-muted table-mobile-hide">Rp @r.Amount.ToString("N0")</td>
                            <td class="small text-muted table-mobile-hide">@r.RequesterName</td>
                            <td><span class="@r.StatusBadgeClass">@r.Status</span></td>
                            <td class="small text-muted table-mobile-hide">@r.CreatedAt.ToString("dd MMM yyyy")</td>
                            <td class="pe-3">
                                <a asp-action="Details" asp-route-id="@r.Id" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@if (Model.TotalPages > 1)
{
    <nav class="mt-3">
        <ul class="pagination pagination-sm justify-content-center">
            @for (int i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.Page ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-page="@i" asp-route-status="@filter?.Status" asp-route-search="@filter?.Search" asp-route-category="@filter?.Category" asp-route-flagged="@filter?.Flagged">@i</a>
                </li>
            }
        </ul>
    </nav>
}
