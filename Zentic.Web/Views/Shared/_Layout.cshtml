<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Zentic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "";
    var fullName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "User";
    var initials = string.Join("", fullName.Split(' ').Take(2).Select(x => x[0].ToString().ToUpper()));
    var pendingCount = ViewBag.PendingCount as int? ?? 0;
    var flaggedCount = ViewBag.FlaggedCount as int? ?? 0;
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();

    <div class="d-flex" id="wrapper">
        <!-- Sidebar -->
        <nav id="sidebar" class="sidebar-nav d-flex flex-column">
            <!-- Brand -->
            <div class="sidebar-brand">
                <div class="d-flex align-items-center gap-2">
                    <div class="sidebar-logo">
                        <i class="bi bi-building-fill text-warning"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white lh-1">Zentic</div>
                        <div class="sidebar-subtitle">PT Zentic</div>
                    </div>
                </div>
            </div>

            <!-- Navigation -->
            <div class="sidebar-scroll flex-grow-1">

                <!-- Main Menu -->
                <div class="sidebar-section-label">MAIN MENU</div>
                <ul class="nav flex-column gap-1 mb-2">
                    <li class="nav-item">
                        <a class="sidebar-link @(currentController == "Home" ? "active" : "")"
                           asp-controller="Home" asp-action="Index">
                            <i class="bi bi-speedometer2"></i>
                            <span>Dashboard</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="sidebar-link @(currentController == "Expense" && currentAction == "Index" && !Context.Request.Query.ContainsKey("status") && !Context.Request.Query.ContainsKey("flagged") ? "active" : "")"
                           asp-controller="Expense" asp-action="Index">
                            <i class="bi bi-receipt"></i>
                            <span>Expense Requisitions</span>
                            @if (pendingCount > 0 && (role == "Admin" || role == "Finance"))
                            {
                                <span class="sidebar-badge">@(pendingCount > 99 ? "99+" : pendingCount.ToString())</span>
                            }
                        </a>
                    </li>
                    @if (role != "Auditor")
                    {
                        <li class="nav-item">
                            <a class="sidebar-link @(currentController == "Expense" && currentAction == "Create" ? "active" : "")"
                               asp-controller="Expense" asp-action="Create">
                                <i class="bi bi-plus-circle"></i>
                                <span>New Requisition</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="sidebar-link @(currentController == "Delegation" ? "active" : "")"
                               asp-controller="Delegation" asp-action="Index">
                                <i class="bi bi-person-down"></i>
                                <span>My Delegations</span>
                            </a>
                        </li>
                    }
                </ul>

                <!-- Approval Menu — Manager & Admin only -->
                @if (role == "Admin" || role == "Finance")
                {
                    <div class="sidebar-section-label">APPROVALS</div>
                    <ul class="nav flex-column gap-1 mb-2">
                        <li class="nav-item">
                            <a class="sidebar-link @(currentController == "Expense" && currentAction == "Index" && Context.Request.Query["status"] == "Submitted" ? "active" : "")"
                               asp-controller="Expense" asp-action="Index" asp-route-status="Submitted">
                                <i class="bi bi-hourglass-split"></i>
                                <span>Pending Approval</span>
                                @if (pendingCount > 0)
                                {
                                    <span class="sidebar-badge sidebar-badge-warning">@(pendingCount > 99 ? "99+" : pendingCount.ToString())</span>
                                }
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="sidebar-link @(currentController == "Expense" && Context.Request.Query["status"] == "UnderReview" ? "active" : "")"
                               asp-controller="Expense" asp-action="Index" asp-route-status="UnderReview">
                                <i class="bi bi-search"></i>
                                <span>Under Review</span>
                            </a>
                        </li>
                        @if (flaggedCount > 0)
                        {
                            <li class="nav-item">
                                <a class="sidebar-link sidebar-link-danger"
                                   asp-controller="Expense" asp-action="Index" asp-route-flagged="true">
                                    <i class="bi bi-flag-fill"></i>
                                    <span>Flagged Items</span>
                                    <span class="sidebar-badge sidebar-badge-danger">@(flaggedCount > 99 ? "99+" : flaggedCount.ToString())</span>
                                </a>
                            </li>
                        }
                    </ul>
                }

                <!-- Reports — Admin, Manager, Auditor -->
                @if (role == "Admin" || role == "Finance" || role == "Auditor")
                {
                    <div class="sidebar-section-label">REPORTS & AUDIT</div>
                    <ul class="nav flex-column gap-1 mb-2">
                        @if (role == "Admin" || role == "Finance")
                        {
                            <li class="nav-item">
                                <a class="sidebar-link @(currentController == "Report" ? "active" : "")"
                                   asp-controller="Report" asp-action="Index">
                                    <i class="bi bi-bar-chart-line"></i>
                                    <span>Reports</span>
                                </a>
                            </li>
                        }
                        <li class="nav-item">
                            <a class="sidebar-link @(currentController == "AuditLog" ? "active" : "")"
                               asp-controller="AuditLog" asp-action="Index">
                                <i class="bi bi-shield-check"></i>
                                <span>Audit Trail</span>
                            </a>
                        </li>
                        @if (role == "Admin" || role == "Finance")
                        {
                            <li class="nav-item">
                                <a class="sidebar-link @(currentController == "Expense" && Context.Request.Query["flagged"] == "true" ? "active" : "")"
                                   asp-controller="Expense" asp-action="Index" asp-route-flagged="true">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    <span>Fraud Detection</span>
                                    @if (flaggedCount > 0)
                                    {
                                        <span class="sidebar-badge sidebar-badge-danger">@(flaggedCount > 99 ? "99+" : flaggedCount.ToString())</span>
                                    }
                                </a>
                            </li>
                        }
                    </ul>
                }

                <!-- Admin Menu -->
                @if (role == "Admin")
                {
                    <div class="sidebar-section-label">ADMINISTRATION</div>
                    <ul class="nav flex-column gap-1 mb-2">
                        <li class="nav-item">
                            <a class="sidebar-link @(currentController == "Vendor" ? "active" : "")"
                               asp-controller="Vendor" asp-action="Index">
                                <i class="bi bi-shop"></i>
                                <span>Vendor Management</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="sidebar-link @(currentController == "User" ? "active" : "")"
                               asp-controller="User" asp-action="Index">
                                <i class="bi bi-people"></i>
                                <span>User Management</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="sidebar-link @(currentController == "Department" ? "active" : "")"
                               asp-controller="Department" asp-action="Index">
                                <i class="bi bi-diagram-3"></i>
                                <span>Departments</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="sidebar-link @(currentController == "ApprovalWorkflow" ? "active" : "")"
                               asp-controller="ApprovalWorkflow" asp-action="Index">
                                <i class="bi bi-diagram-2"></i>
                                <span>Approval Workflows</span>
                            </a>
                        </li>
                    </ul>
                }
            </div>

            <!-- Sidebar Footer: User Info + Dark Mode + Logout -->
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="sidebar-avatar">@initials</div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">@fullName</div>
                        <div class="sidebar-user-role">@role</div>
                    </div>
                </div>
                <div class="d-flex align-items-center gap-2 mt-2">
                    <button class="sidebar-icon-btn" id="darkModeToggle" title="Toggle Dark Mode">
                        <i class="bi bi-moon-fill" id="darkModeIcon"></i>
                    </button>
                    <form asp-controller="Auth" asp-action="Logout" method="post" class="flex-grow-1">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="sidebar-logout-btn">
                            <i class="bi bi-box-arrow-right me-1"></i>Logout
                        </button>
                    </form>
                </div>
            </div>
        </nav>

        <!-- Main Content -->
        <div id="main-content" class="flex-grow-1 d-flex flex-column min-vh-100">
            <!-- Top Navbar -->
            <nav class="topbar">
                <div class="d-flex align-items-center gap-3">
                    <button class="topbar-toggle" id="sidebarToggle" title="Toggle Sidebar">
                        <i class="bi bi-list fs-5"></i>
                    </button>
                    <!-- Breadcrumb -->
                    <nav aria-label="breadcrumb" class="d-none d-md-block">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item">
                                <a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted small">
                                    <i class="bi bi-house me-1"></i>Home
                                </a>
                            </li>
                            @if (currentController != "Home")
                            {
                                <li class="breadcrumb-item text-muted small">@currentController</li>
                            }
                            @if (currentAction != "Index" && currentAction != null)
                            {
                                <li class="breadcrumb-item active small" aria-current="page">@currentAction</li>
                            }
                        </ol>
                    </nav>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <!-- Notification Bell -->
                    @if (pendingCount > 0 && (role == "Admin" || role == "Finance"))
                    {
                        <div class="position-relative">
                            <a asp-controller="Expense" asp-action="Index" asp-route-status="Submitted"
                               class="topbar-icon-btn" title="@pendingCount pending approvals">
                                <i class="bi bi-bell fs-5"></i>
                                <span class="topbar-notif-badge">@(pendingCount > 9 ? "9+" : pendingCount.ToString())</span>
                            </a>
                        </div>
                    }
                    <!-- User Pill -->
                    <div class="topbar-user-pill">
                        <div class="topbar-avatar">@initials</div>
                        <div class="d-none d-sm-block">
                            <div class="topbar-user-name">@fullName</div>
                            <div class="topbar-user-role">@role</div>
                        </div>
                    </div>
                </div>
            </nav>

            <!-- Page Content -->
            <div class="page-content flex-grow-1">
                @if (TempData["Success"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm">
                        <i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @if (TempData["Error"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                    </div>
                }
                @RenderBody()
            </div>

            <!-- Footer -->
            <footer class="page-footer">
                <span>© @DateTime.Now.Year PT Zentic — Finance Division</span>
                <span class="text-muted">v2.0.0</span>
            </footer>
        </div>
    </div>

    <!-- Sidebar Overlay for Mobile -->
    <div id="sidebarOverlay" class="sidebar-overlay" onclick="closeSidebar()"></div>
}
else
{
    @RenderBody()
}

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
<script>
// Sidebar toggle
const sidebar = document.getElementById('sidebar');
const overlay = document.getElementById('sidebarOverlay');
const sidebarToggle = document.getElementById('sidebarToggle');

function closeSidebar() {
    sidebar?.classList.remove('sidebar-open');
    overlay?.classList.remove('show');
}

sidebarToggle?.addEventListener('click', function () {
    if (window.innerWidth < 992) {
        sidebar?.classList.toggle('sidebar-open');
        overlay?.classList.toggle('show');
    } else {
        document.getElementById('wrapper')?.classList.toggle('sidebar-collapsed');
        localStorage.setItem('sidebarCollapsed', document.getElementById('wrapper')?.classList.contains('sidebar-collapsed'));
    }
});

// Restore sidebar state on desktop
if (window.innerWidth >= 992 && localStorage.getItem('sidebarCollapsed') === 'true') {
    document.getElementById('wrapper')?.classList.add('sidebar-collapsed');
}

// Dark mode toggle
const html = document.documentElement;
const darkIcon = document.getElementById('darkModeIcon');
const darkBtn = document.getElementById('darkModeToggle');

function applyTheme(dark) {
    html.setAttribute('data-bs-theme', dark ? 'dark' : 'light');
    document.getElementById('wrapper')?.classList.toggle('dark-mode', dark);
    if (darkIcon) darkIcon.className = dark ? 'bi bi-sun-fill' : 'bi bi-moon-fill';
    localStorage.setItem('darkMode', dark);
}

darkBtn?.addEventListener('click', function () {
    applyTheme(html.getAttribute('data-bs-theme') !== 'dark');
});

// Restore dark mode
if (localStorage.getItem('darkMode') === 'true') applyTheme(true);
</script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
