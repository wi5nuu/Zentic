@model List<Zentic.Application.DTOs.ApprovalWorkflowDto>
@{
    ViewData["Title"] = "Approval Workflows";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-diagram-2 me-2 text-primary"></i>Approval Workflows</h4>
        <p class="text-muted small mb-0">Konfigurasi alur persetujuan requisition</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="EscalationRules" class="btn btn-outline-secondary btn-sm"><i class="bi bi-arrow-up-right-circle me-1"></i>Escalation Rules</a>
        <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Workflow</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header">
        <span class="fw-semibold">Active Workflows <span class="badge bg-primary ms-1">@Model.Count</span></span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="table-mobile-hide">Scope</th>
                        <th class="table-mobile-hide">Amount Range</th>
                        <th>Priority</th>
                        <th>Steps</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">No workflows configured yet.</td></tr>
                    }
                    @foreach (var wf in Model.OrderBy(w => w.Priority))
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@wf.Name</div>
                                <div class="text-muted small d-md-none">@wf.Description</div>
                                <div class="text-muted small table-mobile-hide">@wf.Description</div>
                            </td>
                            <td class="table-mobile-hide">
                                @if (!string.IsNullOrEmpty(wf.DepartmentName))
                                {
                                    <span class="badge bg-light text-dark border">@wf.DepartmentName</span>
                                }
                                else
                                {
                                    <span class="text-muted small">All departments</span>
                                }
                                @if (!string.IsNullOrEmpty(wf.Category))
                                {
                                    <span class="badge bg-light text-dark border ms-1">@wf.Category</span>
                                }
                            </td>
                            <td class="text-muted small table-mobile-hide">
                                @(wf.MinAmount?.ToString("N0") ?? "0") – @(wf.MaxAmount?.ToString("N0") ?? "∞")
                            </td>
                            <td><span class="badge bg-secondary-subtle text-secondary border">@wf.Priority</span></td>
                            <td><span class="badge bg-primary-subtle text-primary border">@wf.Steps.Count step(s)</span></td>
                            <td>
                                @if (wf.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Inactive</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    <a asp-action="Details" asp-route-id="@wf.Id" class="btn btn-sm btn-outline-primary" title="Details"><i class="bi bi-eye"></i></a>
                                    <a asp-action="Edit" asp-route-id="@wf.Id" class="btn btn-sm btn-outline-secondary" title="Edit"><i class="bi bi-pencil"></i></a>
                                    <form asp-action="Delete" asp-route-id="@wf.Id" method="post" onsubmit="return confirm('Delete this workflow?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete"><i class="bi bi-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
