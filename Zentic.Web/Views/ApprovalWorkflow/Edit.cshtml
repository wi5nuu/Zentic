@model Zentic.Application.DTOs.CreateApprovalWorkflowDto
@{
    ViewData["Title"] = "Edit Approval Workflow";
    ViewData["FormAction"] = "Edit";
    ViewData["SubmitLabel"] = "Save Changes";
    ViewData["EditId"] = Context.Request.RouteValues["id"];
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-diagram-2 me-2 text-primary"></i>Edit Approval Workflow</h4>
        <p class="text-muted small mb-0">Mengubah workflow akan mengganti seluruh step yang ada</p>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<partial name="_WorkflowForm" model="Model" />
