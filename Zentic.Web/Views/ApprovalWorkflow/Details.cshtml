@model Zentic.Application.DTOs.ApprovalWorkflowDto
@{
    ViewData["Title"] = Model.Name;
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-diagram-2 me-2 text-primary"></i>@Model.Name</h4>
        <p class="text-muted small mb-0">@Model.Description</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Department</div>
                <div class="fw-semibold">@(Model.DepartmentName ?? "All departments")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Category</div>
                <div class="fw-semibold">@(Model.Category ?? "All categories")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Amount Range</div>
                <div class="fw-semibold">@((Model.MinAmount ?? 0).ToString("N0")) – @(Model.MaxAmount?.ToString("N0") ?? "∞")</div>
            </div>
        </div>
    </div>
    <div class="col-md-3 col-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <div class="text-muted small">Priority / Status</div>
                <div class="fw-semibold">@Model.Priority @(Model.IsActive ? "· Active" : "· Inactive")</div>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header"><span class="fw-semibold">Approval Steps</span></div>
    <div class="card-body p-0">
        @if (!Model.Steps.Any())
        {
            <div class="text-center text-muted py-4">No steps configured.</div>
        }
        else
        {
            <ul class="list-group list-group-flush">
                @foreach (var step in Model.Steps.OrderBy(s => s.StepOrder))
                {
                    <li class="list-group-item d-flex align-items-start gap-3 py-3">
                        <span class="badge bg-primary rounded-circle mt-1" style="min-width:2rem;">@step.StepOrder</span>
                        <div class="flex-grow-1">
                            <div class="fw-semibold">@step.Name
                                @if (step.IsParallel)
                                {
                                    <span class="badge bg-info-subtle text-info border ms-1">Parallel</span>
                                }
                                @if (step.RequireAllApprovers)
                                {
                                    <span class="badge bg-warning-subtle text-warning-emphasis border ms-1">Require All</span>
                                }
                                @if (!step.AllowDelegation)
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border ms-1">No Delegation</span>
                                }
                            </div>
                            <div class="text-muted small">
                                Approver: <strong>@step.ApproverType</strong>
                                @if (step.SpecificUserName != null)
                                {
                                    <span>— @step.SpecificUserName</span>
                                }
                                else if (step.RequiredRole != null)
                                {
                                    <span>— Role: @step.RequiredRole</span>
                                }
                                else if (step.DepartmentName != null)
                                {
                                    <span>— @step.DepartmentName</span>
                                }
                            </div>
                            @if (step.EscalationRuleName != null)
                            {
                                <div class="small mt-1"><i class="bi bi-arrow-up-right-circle text-warning me-1"></i>Escalation: @step.EscalationRuleName</div>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>
</div>
