@model List<Zentic.Application.DTOs.EscalationRuleDto>
@{
    ViewData["Title"] = "Escalation Rules";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-arrow-up-right-circle me-2 text-warning"></i>Escalation Rules</h4>
        <p class="text-muted small mb-0">Aturan eskalasi approval yang tertunda</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm"><i class="bi bi-diagram-2 me-1"></i>Workflows</a>
        <a asp-action="CreateEscalationRule" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>Add Rule</a>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header">
        <span class="fw-semibold">Active Rules <span class="badge bg-primary ms-1">@Model.Count</span></span>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th class="table-mobile-hide">Trigger</th>
                        <th>After (hours)</th>
                        <th class="table-mobile-hide">Escalate To</th>
                        <th class="table-mobile-hide">Amount Range</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">No escalation rules configured.</td></tr>
                    }
                    @foreach (var rule in Model)
                    {
                        <tr>
                            <td>
                                <div class="fw-semibold">@rule.Name</div>
                                <div class="text-muted small">@(rule.Description ?? "")</div>
                            </td>
                            <td class="table-mobile-hide"><span class="badge bg-light text-dark border">@rule.Trigger</span></td>
                            <td>@rule.EscalationAfterHours</td>
                            <td class="table-mobile-hide small">
                                @if (!string.IsNullOrEmpty(rule.EscalateToUserName))
                                {
                                    <span>@rule.EscalateToUserName</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">@rule.EscalateToRole</span>
                                }
                                @if (!string.IsNullOrEmpty(rule.DepartmentName))
                                {
                                    <div class="text-muted">@rule.DepartmentName</div>
                                }
                            </td>
                            <td class="text-muted small table-mobile-hide">
                                @(rule.MinAmount?.ToString("N0") ?? "0") – @(rule.MaxAmount?.ToString("N0") ?? "∞")
                            </td>
                            <td>
                                @if (rule.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Active</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
