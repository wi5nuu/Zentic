@model Zentic.Application.ViewModels.LoginViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - Zentic</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />
</head>
<body class="bg-light">
    <div class="min-vh-100 d-flex align-items-center justify-content-center">
        <div class="card shadow-sm" style="width:420px;">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <div class="bg-warning rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:56px;height:56px;">
                        <i class="bi bi-building fs-4 text-dark"></i>
                    </div>
                    <h4 class="fw-bold mb-0">Zentic</h4>
                    <p class="text-muted small">PT Zentic — Enterprise Edition</p>
                </div>
                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div asp-validation-summary="All" class="alert alert-danger py-2 small mb-3"></div>
                    }
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" class="form-control" placeholder="you@company.internal" autocomplete="email" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="Password" class="form-label fw-semibold"></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input asp-for="Password" class="form-control" placeholder="••••••••" autocomplete="current-password" />
                        </div>
                        <span asp-validation-for="Password" class="text-danger small"></span>
                    </div>
                    <div class="mb-3 form-check">
                        <input asp-for="RememberMe" class="form-check-input" />
                        <label asp-for="RememberMe" class="form-check-label"></label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                    </button>
                </form>
                <div class="text-muted small text-center mt-3">
                    <i class="bi bi-shield-lock me-1"></i>Authorized personnel only. Contact IT for access.
                </div>

                <hr class="my-3" />
                <div class="small">
                    <button class="btn btn-sm btn-outline-secondary w-100 mb-2" type="button" data-bs-toggle="collapse" data-bs-target="#demoAccounts">
                        <i class="bi bi-eye me-1"></i>Demo Accounts
                    </button>
                    <div class="collapse" id="demoAccounts">
                        <div class="table-responsive">
                            <table class="table table-sm table-bordered mb-0 small">
                                <thead class="table-light">
                                    <tr><th>Email</th><th>Password</th><th>Role</th></tr>
                                </thead>
                                <tbody>
                                    <tr><td>admin@company.internal</td><td>P@ssw0rd</td><td><span class="badge bg-danger">Admin</span></td></tr>
                                    <tr><td>finance.manager@company.internal</td><td>P@ssw0rd</td><td><span class="badge bg-primary">Finance</span></td></tr>
                                    <tr><td>budi.santoso@company.internal</td><td>P@ssw0rd</td><td><span class="badge bg-success">Staff</span></td></tr>
                                    <tr><td>siti.rahayu@company.internal</td><td>P@ssw0rd</td><td><span class="badge bg-primary">Manager</span></td></tr>
                                    <tr><td>auditor@company.internal</td><td>P@ssw0rd</td><td><span class="badge bg-warning text-dark">Auditor</span></td></tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
