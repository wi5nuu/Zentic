@{
    ViewData["Title"] = "Access Denied";
}
<div class="text-center py-5">
    <div class="display-1 fw-bold text-warning mb-3">403</div>
    <i class="bi bi-shield-lock-fill fs-1 text-muted d-block mb-3"></i>
    <h4 class="fw-bold mb-2">Access Denied</h4>
    <p class="text-muted mb-4">You do not have permission to access this page. Contact your administrator if you believe this is a mistake.</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
        <i class="bi bi-house me-2"></i>Back to Dashboard
    </a>
</div>
