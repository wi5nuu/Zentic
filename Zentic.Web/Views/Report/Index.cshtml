@model Zentic.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "Reports";
}
<div class="d-flex justify-content-between align-items-center mb-4 page-header-row">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-bar-chart-line me-2 text-primary"></i>Reports</h4>
        <p class="text-muted small mb-0">Ringkasan dan analisis expense requisition</p>
    </div>
    <a asp-controller="Expense" asp-action="Index" asp-route-status="Approved" class="btn btn-outline-primary btn-sm">
        <i class="bi bi-receipt me-1"></i>View Approved List
    </a>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                <div class="rounded-3 bg-primary bg-opacity-10 p-2 p-md-3 flex-shrink-0"><i class="bi bi-receipt fs-5 text-primary"></i></div>
                <div><div class="text-muted small">Total</div><div class="fw-bold kpi-value fs-5">@Model.TotalRequisitions</div></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                <div class="rounded-3 bg-success bg-opacity-10 p-2 p-md-3 flex-shrink-0"><i class="bi bi-check-circle fs-5 text-success"></i></div>
                <div><div class="text-muted small">Approved</div><div class="fw-bold kpi-value fs-5 text-success">@Model.ApprovedThisMonth</div></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                <div class="rounded-3 bg-danger bg-opacity-10 p-2 p-md-3 flex-shrink-0"><i class="bi bi-x-circle fs-5 text-danger"></i></div>
                <div><div class="text-muted small">Rejected</div><div class="fw-bold kpi-value fs-5 text-danger">@Model.RejectedThisMonth</div></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                <div class="rounded-3 bg-success bg-opacity-10 p-2 p-md-3 flex-shrink-0"><i class="bi bi-cash-stack fs-5 text-success"></i></div>
                <div><div class="text-muted small">Total (IDR)</div><div class="fw-bold" style="font-size:clamp(0.8rem,2vw,1rem);">Rp @Model.TotalAmountApproved.ToString("N0")</div></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <!-- Category Breakdown -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header">
                <span class="fw-semibold">Category Breakdown</span>
            </div>
            <div class="card-body">
                @if (!Model.CategoryBreakdown.Any())
                {
                    <p class="text-muted small text-center py-3">No data yet.</p>
                }
                @foreach (var c in Model.CategoryBreakdown.OrderByDescending(x => x.TotalAmount))
                {
                    var maxAmt = Model.CategoryBreakdown.Max(x => x.TotalAmount);
                    var pct = maxAmt > 0 ? (int)(c.TotalAmount / maxAmt * 100) : 0;
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="fw-semibold">@c.Category</span>
                            <span class="text-muted">@c.Count req</span>
                        </div>
                        <div class="progress" style="height:6px;">
                            <div class="progress-bar bg-primary" style="width:@pct%"></div>
                        </div>
                        <div class="text-muted" style="font-size:0.75rem;">Rp @c.TotalAmount.ToString("N0")</div>
                    </div>
                }
            </div>
        </div>
    </div>
    <!-- Monthly Summary -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header">
                <span class="fw-semibold">This Month Summary</span>
            </div>
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-6">
                        <div class="p-3 bg-success bg-opacity-10 rounded-3 text-center">
                            <div class="fs-2 fw-bold text-success">@Model.ApprovedThisMonth</div>
                            <div class="small text-muted">Approved</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="p-3 bg-danger bg-opacity-10 rounded-3 text-center">
                            <div class="fs-2 fw-bold text-danger">@Model.RejectedThisMonth</div>
                            <div class="small text-muted">Rejected</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-primary bg-opacity-10 rounded-3 text-center">
                            <div class="fs-4 fw-bold text-primary">Rp @Model.TotalAmountThisMonth.ToString("N0")</div>
                            <div class="small text-muted">Total Amount This Month</div>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="p-3 bg-warning bg-opacity-10 rounded-3 text-center">
                            <div class="fs-2 fw-bold text-warning">@Model.FlaggedForReview</div>
                            <div class="small text-muted">Flagged for Fraud Review</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
