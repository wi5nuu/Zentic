@model Zentic.Application.DTOs.CreateApprovalDelegationDto
@{
    ViewData["Title"] = "New Delegation";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-person-down me-2 text-primary"></i>New Approval Delegation</h4>
        <p class="text-muted small mb-0">Serahkan wewenang approval ke rekan kerja</p>
    </div>
    <a asp-action="Index" class="btn btn-sm btn-outline-secondary"><i class="bi bi-arrow-left me-1"></i>Back</a>
</div>

<div class="card border-0 shadow-sm" style="max-width:560px;">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

            <div class="mb-3">
                <label class="form-label fw-semibold">Delegate To <span class="text-danger">*</span></label>
                <select asp-for="DelegateId" asp-items="ViewBag.Users" class="form-select" required>
                    <option value="">— Select colleague —</option>
                </select>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Start Date <span class="text-danger">*</span></label>
                    <input asp-for="StartDate" type="date" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">End Date <span class="text-danger">*</span></label>
                    <input asp-for="EndDate" type="date" class="form-control" required />
                </div>
            </div>
            <div class="mb-3">
                <label class="form-label fw-semibold">Reason</label>
                <textarea asp-for="Reason" class="form-control" rows="2" placeholder="e.g. Annual leave..."></textarea>
            </div>
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Department (optional)</label>
                    <select asp-for="DepartmentId" asp-items="ViewBag.Departments" class="form-select">
                        <option value="">— All departments —</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label fw-semibold">Max Amount (optional)</label>
                    <input asp-for="MaxAmount" type="number" step="0.01" min="0" class="form-control" />
                </div>
            </div>

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary"><i class="bi bi-check-lg me-1"></i>Create Delegation</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
