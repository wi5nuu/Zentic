@model (List<Zentic.Application.DTOs.ApprovalDelegationDto> Incoming, List<Zentic.Application.DTOs.ApprovalDelegationDto> Outgoing)
@{
    ViewData["Title"] = "My Approval Delegations";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h4 class="fw-bold mb-0"><i class="bi bi-person-down me-2 text-primary"></i>Approval Delegations</h4>
        <p class="text-muted small mb-0">Delegasi wewenang approval saat Anda cuti/tidak tersedia</p>
    </div>
    <a asp-action="Create" class="btn btn-primary btn-sm"><i class="bi bi-plus-lg me-1"></i>New Delegation</a>
</div>

<div class="row g-3">
    <!-- Outgoing -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header">
                <span class="fw-semibold">Delegated By Me <span class="badge bg-primary ms-1">@Model.Outgoing.Count</span></span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Outgoing.Any())
                {
                    <div class="text-center text-muted py-4">You have no active delegations.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var d in Model.Outgoing)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-start py-3">
                                <div>
                                    <div class="fw-semibold"><i class="bi bi-arrow-right-circle text-muted me-1"></i>To: @d.DelegateName</div>
                                    <div class="text-muted small">@d.StartDate.ToString("dd MMM yyyy") – @d.EndDate.ToString("dd MMM yyyy")</div>
                                    @if (!string.IsNullOrEmpty(d.Reason))
                                    {
                                        <div class="small">@d.Reason</div>
                                    }
                                    @if (d.MaxAmount != null)
                                    {
                                        <div class="text-muted small">Max: @d.MaxAmount?.ToString("N0")</div>
                                    }
                                </div>
                                <form asp-action="Revoke" asp-route-id="@d.Id" method="post" onsubmit="return confirm('Revoke this delegation?');">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-outline-danger"><i class="bi bi-x-lg me-1"></i>Revoke</button>
                                </form>
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>

    <!-- Incoming -->
    <div class="col-lg-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header">
                <span class="fw-semibold">Delegated To Me <span class="badge bg-success ms-1">@Model.Incoming.Count</span></span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Incoming.Any())
                {
                    <div class="text-center text-muted py-4">No one has delegated approvals to you.</div>
                }
                else
                {
                    <ul class="list-group list-group-flush">
                        @foreach (var d in Model.Incoming)
                        {
                            <li class="list-group-item py-3">
                                <div class="fw-semibold"><i class="bi bi-arrow-left-circle text-success me-1"></i>From: @d.DelegatorName</div>
                                <div class="text-muted small">@d.StartDate.ToString("dd MMM yyyy") – @d.EndDate.ToString("dd MMM yyyy")</div>
                                @if (d.MaxAmount != null)
                                {
                                    <div class="text-muted small">Max amount: @d.MaxAmount?.ToString("N0")</div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
