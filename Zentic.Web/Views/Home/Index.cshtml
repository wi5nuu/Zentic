@model Zentic.Application.DTOs.DashboardDto
@{
    ViewData["Title"] = "Dashboard";
}
<div class="d-flex justify-content-between align-items-center mb-4 page-header-row">
    <div>
        <h4 class="fw-bold mb-0">Dashboard</h4>
        <p class="text-muted small mb-0">@DateTime.Now.ToString("dddd, dd MMMM yyyy")</p>
    </div>
    <a asp-controller="Expense" asp-action="Create" class="btn btn-primary">
        <i class="bi bi-plus-circle me-2"></i>New Requisition
    </a>
</div>

<!-- KPI Cards -->
<div class="row g-3 mb-4">
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                <div class="rounded-3 bg-primary bg-opacity-10 p-2 p-md-3 flex-shrink-0"><i class="bi bi-receipt fs-5 fs-md-4 text-primary"></i></div>
                <div><div class="text-muted small">Total Requisitions</div><div class="fs-5 fs-md-4 fw-bold kpi-value">@Model.TotalRequisitions</div></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                <div class="rounded-3 bg-warning bg-opacity-10 p-2 p-md-3 flex-shrink-0"><i class="bi bi-hourglass-split fs-5 fs-md-4 text-warning"></i></div>
                <div><div class="text-muted small">Pending Approval</div><div class="fs-5 fs-md-4 fw-bold kpi-value">@Model.PendingApproval</div></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                <div class="rounded-3 bg-danger bg-opacity-10 p-2 p-md-3 flex-shrink-0"><i class="bi bi-flag fs-5 fs-md-4 text-danger"></i></div>
                <div><div class="text-muted small">Flagged</div><div class="fs-5 fs-md-4 fw-bold text-danger kpi-value">@Model.FlaggedForReview</div></div>
            </div>
        </div>
    </div>
    <div class="col-6 col-xl-3">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-2 gap-md-3">
                <div class="rounded-3 bg-success bg-opacity-10 p-2 p-md-3 flex-shrink-0"><i class="bi bi-cash-stack fs-5 fs-md-4 text-success"></i></div>
                <div><div class="text-muted small">Approved (IDR)</div><div class="fw-bold kpi-value" style="font-size:clamp(0.85rem,2vw,1.1rem);">@Model.TotalAmountApproved.ToString("N0")</div></div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3 pb-2 d-flex justify-content-between">
                <h6 class="fw-bold mb-0">Recent Requisitions</h6>
                <a asp-controller="Expense" asp-action="Index" class="btn btn-sm btn-outline-secondary">View All</a>
            </div>
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-3">Number</th>
                            <th>Title</th>
                            <th>Requester</th>
                            <th>Amount</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.RecentRequisitions.Any())
                        {
                            <tr><td colspan="5" class="text-center py-4 text-muted">No requisitions yet.</td></tr>
                        }
                        @foreach (var r in Model.RecentRequisitions)
                        {
                            <tr>
                                <td class="ps-3">
                                    <a asp-controller="Expense" asp-action="Details" asp-route-id="@r.Id" class="fw-semibold text-decoration-none small">@r.RequisitionNumber</a>
                                    @if (r.IsFlagged) { <i class="bi bi-flag-fill text-danger ms-1" title="Flagged for review"></i> }
                                </td>
                                <td class="small">@r.Title</td>
                                <td class="small text-muted">@r.RequesterName</td>
                                <td class="small">Rp @r.Amount.ToString("N0")</td>
                                <td><span class="@r.StatusBadgeClass">@r.Status</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-0 pt-3 pb-2"><h6 class="fw-bold mb-0">Category Breakdown</h6></div>
            <div class="card-body">
                @if (!Model.CategoryBreakdown.Any())
                {
                    <p class="text-muted small text-center py-3">No data yet.</p>
                }
                @foreach (var c in Model.CategoryBreakdown.OrderByDescending(x => x.TotalAmount))
                {
                    var maxAmt = Model.CategoryBreakdown.Max(x => x.TotalAmount);
                    var pct = maxAmt > 0 ? (int)(c.TotalAmount / maxAmt * 100) : 0;
                    <div class="mb-3">
                        <div class="d-flex justify-content-between small mb-1"><span>@c.Category</span><span class="text-muted">@c.Count req</span></div>
                        <div class="progress" style="height:6px;"><div class="progress-bar bg-primary" style="width:@pct%"></div></div>
                        <div class="text-muted" style="font-size:0.75rem;">Rp @c.TotalAmount.ToString("N0")</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
